{
  "schemaVersion": 1,
  "contractVersion": "1.3.0",
  "projectId": "mindmake-award-panel-website-redesign",
  "stateRoute": "project-documentation/website-redesign/STATE.md",
  "owners": {
    "orchestration": "build-apps-with-krish",
    "taste": "krish-design",
    "implementation": "krish-build",
    "taskValidation": "ux-testing-agent",
    "completion": "verification-loop",
    "materialApproval": "Krish",
    "exceptions": "Krish",
    "release": "explicit-action-time-approval"
  },
  "surfaces": ["desktop", "mobile"],
  "requiredCoverage": [
    "product_truth",
    "storyboard_narrative",
    "information_architecture_guidance",
    "conversion_trust",
    "visual_craft",
    "design_system_integrity",
    "device_specific_interaction",
    "motion_scroll_causality",
    "accessibility_assistive_technology",
    "content_clarity_voice",
    "functional_state_recovery",
    "responsive_layout",
    "performance_technical",
    "originality_brand",
    "evidence_provenance"
  ],
  "briefFidelity": {
    "required": true,
    "ownerDirectionIsHardGate": true,
    "candidateTraceRequired": true,
    "scoresCannotOverride": true,
    "blockOnUnresolved": true,
    "requiredFields": [
      "accepted_outcomes",
      "accepted_experience",
      "authoritative_evidence",
      "rejected_patterns",
      "candidate_mapping",
      "omissions",
      "contradictions"
    ],
    "authoritativeSources": [
      "project-documentation/website-redesign/STATE.md",
      "project-documentation/06_CURRENT_STATE.md",
      "quality/website-redesign/continuity-contract.v1.json"
    ]
  },
  "feedbackReconciliation": {
    "required": true,
    "ledger": "project-documentation/website-redesign/feedback-ledger.json",
    "verbatimRequired": true,
    "decisionNotesRequired": true,
    "overallNoteRequired": true,
    "submissionIsApproval": false,
    "blockOnUnresolved": true,
    "judgesReceiveRequirements": true,
    "blockingStatuses": ["open", "implemented-awaiting-review"],
    "requiredFields": ["id", "exactFeedback", "source", "surface", "section", "device", "element", "classification", "requiredOutcome", "acceptanceTest", "status", "resolution", "evidence"]
  },
  "reviewReadiness": {
    "blockingStatuses": ["fail", "inconclusive", "not_run"],
    "requiredChecks": [
      "artifact_identity",
      "runtime_identity",
      "fresh_self_owned_capture",
      "broken_links_controls_assets",
      "overflow_overlap_clipping",
      "layout_alignment",
      "text_wrap_orphans_content_range",
      "contrast",
      "keyboard_focus_semantics",
      "touch_targets",
      "viewport_safe_areas_fixed_chrome",
      "reduced_motion",
      "section_fit_scroll_contract",
      "duplicate_components_claims",
      "placeholder_debug_backup_singer_copy",
      "console_network_user_impact",
      "single_dom_scroll_context",
      "continuous_forward_reverse_journey",
      "section_seam_collision",
      "judge_evidence_identity"
    ],
    "selfOwnedRuntime": true,
    "candidateBoundEvidence": true
  },
  "presentationFirewall": {
    "required": true,
    "failClosed": true,
    "candidateManifestRequired": true,
    "singleDomScrollContextRequired": true,
    "embeddedFrameIntegrationAllowed": false,
    "candidateBoundReceiptRequired": true,
    "directReviewCommandRequired": true,
    "adversarialSelfTestRequired": true,
    "blockingStatuses": ["fail", "inconclusive", "not_run", "stale", "mismatch", "missing"]
  },
  "continuity": {
    "required": true,
    "requiredFields": ["route", "viewport", "action", "expected", "observed", "evidence"],
    "blockOnAnyUnresolved": true
  },
  "blindPanel": {
    "required": true,
    "ownerHistoryVisible": false,
    "minimumIndependentJurors": 6,
    "scoresCannotOverrideHardGates": true,
    "roles": [
      { "id": "desktop_art_system", "surface": "desktop", "coverage": ["visual_craft", "design_system_integrity", "responsive_layout"] },
      { "id": "desktop_narrative_journey", "surface": "desktop", "coverage": ["storyboard_narrative", "information_architecture_guidance", "content_clarity_voice"] },
      { "id": "desktop_immersion_interaction", "surface": "desktop", "coverage": ["device_specific_interaction", "motion_scroll_causality", "functional_state_recovery"] },
      { "id": "desktop_conversion_trust", "surface": "desktop", "coverage": ["product_truth", "conversion_trust", "information_architecture_guidance"] },
      { "id": "desktop_ux_accessibility_technical", "surface": "desktop", "coverage": ["accessibility_assistive_technology", "performance_technical", "evidence_provenance"] },
      { "id": "desktop_inspiration_originality", "surface": "desktop", "coverage": ["originality_brand", "visual_craft"] },
      { "id": "mobile_art_system", "surface": "mobile", "coverage": ["visual_craft", "design_system_integrity", "responsive_layout"] },
      { "id": "mobile_narrative_journey", "surface": "mobile", "coverage": ["storyboard_narrative", "information_architecture_guidance", "content_clarity_voice"] },
      { "id": "mobile_immersion_interaction", "surface": "mobile", "coverage": ["device_specific_interaction", "motion_scroll_causality", "functional_state_recovery"] },
      { "id": "mobile_conversion_trust", "surface": "mobile", "coverage": ["product_truth", "conversion_trust", "information_architecture_guidance"] },
      { "id": "mobile_ux_accessibility_technical", "surface": "mobile", "coverage": ["accessibility_assistive_technology", "performance_technical", "evidence_provenance"] },
      { "id": "mobile_inspiration_originality", "surface": "mobile", "coverage": ["originality_brand", "visual_craft"] }
    ]
  },
  "releaseEvidence": {
    "automatedBrowsers": ["Chromium", "WebKit", "Firefox"],
    "physicalDevices": ["iPhone Safari + VoiceOver", "Android Chrome + TalkBack"],
    "physicalCannotBeInferred": true
  },
  "commands": {
    "definitions": "npm run qa:award-panel:definitions",
    "reviewReadiness": "npm run qa:material-review -- quality/website-redesign/material-review-candidate.json",
    "presentation": "npm run review:material -- quality/website-redesign/material-review-candidate.json",
    "continuity": "npm run qa:full-route-continuity",
    "blindPanel": "npm run qa:award-panel:capture && npm run qa:award-panel:aggregate",
    "status": "npm run qa:award-panel:status"
  }
}
