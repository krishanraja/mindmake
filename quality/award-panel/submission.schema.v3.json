{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindmake.co/quality/award-panel/submission.schema.v3.json",
  "title": "Blind award-panel v3 judge submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "evidenceManifestSha256", "candidateSha256", "rubricSha256",
    "contextId", "contextProof", "jurorId", "judgeId", "surface", "submittedAt", "attestation",
    "consumedObservationIds", "journeyTrace", "scrutiny", "dimensions", "hardGates", "summary", "confidence"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "runId": { "type": "string", "minLength": 1 },
    "evidenceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rubricSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contextId": { "type": "string", "minLength": 16 },
    "contextProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executorId", "startedAt"],
      "properties": {
        "executorId": { "type": "string", "minLength": 8 },
        "startedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      }
    },
    "jurorId": { "type": "string", "minLength": 1 },
    "judgeId": { "type": "string", "minLength": 1 },
    "surface": { "enum": ["desktop", "mobile"] },
    "submittedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sawPriorCritique", "sawOtherVerdicts", "sawIterationHistory", "usedMatchingCandidate", "usedFrozenEvidence", "independentContext"],
      "properties": {
        "sawPriorCritique": { "const": false },
        "sawOtherVerdicts": { "const": false },
        "sawIterationHistory": { "const": false },
        "usedMatchingCandidate": { "const": true },
        "usedFrozenEvidence": { "const": true },
        "independentContext": { "const": true }
      }
    },
    "consumedObservationIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "journeyTrace": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "viewport", "action", "expected", "observed", "observationIds"],
        "properties": {
          "route": { "type": "string", "pattern": "^/" },
          "viewport": { "type": "string", "minLength": 3 },
          "action": { "type": "string", "minLength": 12 },
          "expected": { "type": "string", "minLength": 12 },
          "observed": { "type": "string", "minLength": 12 },
          "observationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "scrutiny": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "status", "route", "viewport", "finding", "observationIds"],
        "properties": {
          "category": { "enum": ["story", "journey", "conversion", "design_system", "duplication", "layout", "contrast", "interaction", "accessibility", "reliability", "originality"] },
          "status": { "enum": ["pass", "fail", "inconclusive"] },
          "route": { "type": "string", "pattern": "^/" },
          "viewport": { "type": "string", "minLength": 3 },
          "finding": { "type": "string", "minLength": 12 },
          "observationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "dimensions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "evidence", "raiseCondition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 10, "multipleOf": 0.1 },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route", "viewport", "action", "expected", "observation", "observationIds"],
              "properties": {
                "route": { "type": "string", "pattern": "^/" },
                "viewport": { "type": "string", "minLength": 3 },
                "action": { "type": "string", "minLength": 12 },
                "expected": { "type": "string", "minLength": 12 },
                "observation": { "type": "string", "minLength": 12 },
                "observationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "raiseCondition": { "type": "string", "minLength": 12 }
        }
      }
    },
    "hardGates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "route", "viewport", "action", "expected", "evidence", "observationIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "inconclusive"] },
          "route": { "type": "string", "pattern": "^/" },
          "viewport": { "type": "string", "minLength": 3 },
          "action": { "type": "string", "minLength": 12 },
          "expected": { "type": "string", "minLength": 12 },
          "evidence": { "type": "string", "minLength": 12 },
          "observationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "summary": { "type": "string", "minLength": 20 },
    "confidence": { "enum": ["high", "medium", "low"] }
  }
}
