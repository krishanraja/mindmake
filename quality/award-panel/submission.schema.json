{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindmake.co/quality/award-panel/submission.schema.json",
  "title": "Blind award-panel judge submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "evidenceManifestSha256", "candidateSha256", "rubricSha256",
    "contextId", "jurorId", "judgeId", "surface", "submittedAt", "attestation",
    "consumedObservationIds", "dimensions", "hardGates", "summary", "confidence"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "evidenceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rubricSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contextId": { "type": "string", "minLength": 16 },
    "jurorId": { "type": "string", "minLength": 1 },
    "judgeId": { "type": "string", "minLength": 1 },
    "surface": { "enum": ["desktop", "mobile"] },
    "submittedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sawPriorCritique", "sawOtherVerdicts", "sawIterationHistory", "usedProductionOnly", "usedFrozenEvidence", "independentContext"],
      "properties": {
        "sawPriorCritique": { "const": false },
        "sawOtherVerdicts": { "const": false },
        "sawIterationHistory": { "const": false },
        "usedProductionOnly": { "const": true },
        "usedFrozenEvidence": { "const": true },
        "independentContext": { "const": true }
      }
    },
    "consumedObservationIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "evidence", "raiseCondition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 10, "multipleOf": 0.1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route", "viewport", "observation", "observationIds"],
              "properties": {
                "route": { "type": "string", "minLength": 1 },
                "viewport": { "type": "string", "minLength": 1 },
                "observation": { "type": "string", "minLength": 12 },
                "observationIds": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "raiseCondition": { "type": "string", "minLength": 12 }
        }
      }
    },
    "hardGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "observationIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "inconclusive"] },
          "evidence": { "type": "string", "minLength": 12 },
          "observationIds": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 20 },
    "confidence": { "enum": ["high", "medium", "low"] }
  }
}
