{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/testimonials",
      "destination": "/testimonials/index.html"
    },
    {
      "source": "/((?!assets/|testimonials).*)",
      "destination": "/index.html"
    }
  ]
}
