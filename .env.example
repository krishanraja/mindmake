# ---------------------------------------------------------------------------
# Client-side environment variables (exposed to the browser via Vite)
# ---------------------------------------------------------------------------
# Supabase project identifier
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
# Supabase anon / publishable key (safe for the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Fail-closed switch for the future versioned Mindmake brief endpoint.
# Leave false until submit-mindmake-brief is approved, deployed and verified.
VITE_MINDMAKE_BRIEF_HANDOFF_ENABLED=false

# ---------------------------------------------------------------------------
# Server-side secrets (Supabase Edge Functions only, never exposed to client)
# ---------------------------------------------------------------------------
# Anthropic Claude API key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Google AI (Gemini) API key
GOOGLE_AI_API_KEY=your-google-ai-api-key
# Optional live company enrichment. Missing providers degrade to the safe read.
BRANDFETCH_API_KEY=your-brandfetch-api-key
BRANDFETCH_CLIENT_ID=your-brandfetch-client-id
PEOPLEDATALABS_API_KEY=your-people-data-labs-api-key
BUILTWITH_API_KEY=your-builtwith-api-key
EXA_API_KEY=your-exa-api-key
NEWSAPI_API_KEY=your-newsapi-api-key
# Resend transactional email API key
RESEND_API_KEY=your-resend-api-key
# Supabase service role key (full DB access, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase project URL (used by edge functions)
SUPABASE_URL=https://your-project.supabase.co
# Artificial Analysis API key
ARTIFICIALANALYSIS_API_KEY=your-artificialanalysis-api-key
# Brave Search API key
BRAVE_SEARCH_API=your-brave-search-api-key
# OpenAI API key
OPENAI_API_KEY=your-openai-api-key
# Perplexity API key
PERPLEXITY_API_KEY=your-perplexity-api-key
# Stripe secret key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Mindmake brief rate identifiers are HMACed with this independent secret.
MINDMAKE_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
# Mindmake verification codes are derived and HMACed with this separate secret.
MINDMAKE_VERIFICATION_SECRET=replace-with-a-different-32-character-secret
# Transactional sender. Keep the display name and verified sender address fixed.
MINDMAKE_BRIEF_FROM=Mindmake <briefs@mindmake.co>
# Private operator hand-off recipient.
MINDMAKE_OPERATOR_EMAIL=krish@themindmaker.ai
# Canonical public Mindmake URL. This origin must also appear below.
MINDMAKE_PUBLIC_URL=https://mindmake.co
# Exact comma-separated browser origins. Do not use wildcards or pathnames.
MINDMAKE_ALLOWED_ORIGINS=https://mindmake.co,https://www.mindmake.co
